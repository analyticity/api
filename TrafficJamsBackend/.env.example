# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# .env is listed in .gitignore and should NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Async URL used by FastAPI / SQLAlchemy at runtime.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/accidents_db

# Sync URL used by Alembic migrations only.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:password@localhost:5432/accidents_db

# ── Data source ───────────────────────────────────────────────────────────────
# "csv"      — read accidents and road segments from local CSV files (no DB required)
# "postgres" — read from PostgreSQL / PostGIS
DATA_SOURCE=postgres

# ── CSV file paths ─────────────────────────────────────────────────────────────
# Only used when DATA_SOURCE=csv.
# Paths are relative to the working directory (api/TrafficJamsBackend/ when running locally).
# When running inside Docker use the absolute container path where the file is mounted.
ACCIDENTS_CSV_PATH=../../accidents_data.csv
ROAD_SEGMENTS_CSV_PATH=../../road_segments.csv

# ── DBSCAN defaults (also used for auto-clustering on startup) ────────────────
DBSCAN_EPS_METERS=100.0
DBSCAN_MIN_SAMPLES=3

# ── Auto-clustering ────────────────────────────────────────────────────────────
# When true: if dangerous_road_clusters is empty at boot, clustering runs once automatically.
# Requires DATA_SOURCE=postgres. Keep false in production unless intentional.
AUTO_CLUSTER_ON_STARTUP=true

# ── ML models ─────────────────────────────────────────────────────────────────
# Directory containing classifier.joblib, regressor.joblib, and metadata.json.
# Run scripts/train_model.py to generate these files before starting the API.
# In Docker this path is always /app/models unless you mount a different volume.
MODELS_DIR=models

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
APP_TITLE=Accidents API
APP_VERSION=1.0.0

# ── Server (read by entrypoint.sh) ────────────────────────────────────────────
# Port the uvicorn server listens on inside the container.
PORT=8000

# Number of uvicorn worker processes.
# Keep at 1 when DATA_SOURCE=csv (in-memory store is process-local).
# Increase for DATA_SOURCE=postgres.
WORKERS=1